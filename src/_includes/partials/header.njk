<header class="site-header">
  <a href="#main" class="skip-link">Skip to content</a>
  <div class="wrap header-inner">
    <a class="brand" href="/" aria-label="Simpedu home">
      <img src="/assets/logo.webp" alt="" width="32" height="32">
      <span>Simpedu</span>
    </a>
    <button type="button" class="menu-btn" aria-expanded="false" aria-controls="primary-nav" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
    <nav aria-label="Primary" id="primary-nav">
      <a href="/#work"{% if page.url == "/" %} aria-current="page"{% endif %}>Our Work</a>
      <a href="/services/"{% if page.url == "/services/" %} aria-current="page"{% endif %}>Services</a>
      <a href="/about/"{% if page.url == "/about/" %} aria-current="page"{% endif %}>About</a>
      <button type="button" data-theme-toggle class="theme-btn" aria-label="Toggle color theme">
        <span class="theme-icon" aria-hidden="true"></span>
        <span data-theme-label>Dark</span>
      </button>
      <a href="/contact/?service=demo" class="btn btn-primary">Book a demo</a>
    </nav>
  </div>
</header>
